# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Also pins the exact CORS-allowed origin for this deployment (see server.ts).
APP_URL="MY_APP_URL"

# API_KEY: Optional shared-secret for write (POST/PUT/PATCH/DELETE) API requests.
# When set, callers must send it as the `x-api-key` header. Leave unset for local/dev use
# where every route stays unauthenticated (current default behavior).
API_KEY=""

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Required. Server-side Supabase connection —
# this app has no per-user auth, so the service-role key is used to bypass RLS entirely
# from the server. Never expose this key to the frontend.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# QSTASH_TOKEN / QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY: Used to pace
# bulk-outreach email sends via delayed Upstash QStash messages instead of an in-process
# setTimeout loop (required for Vercel serverless — no long-lived process between requests).
# Leave unset for local dev to fall back to the old in-process pacing loop.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
